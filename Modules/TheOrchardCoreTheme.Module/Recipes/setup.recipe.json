{
  "name": "TheOrchardCoreTheme.Setup",
  "displayName": "Orchard Core Website - Setup",
  "description": "Installs a fresh site that uses TheOrchardCoreTheme. Enabling the theme pulls in the companion module, whose migration runs the content model and seed content automatically.",
  "author": "Orchard Core",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "theme" ],
  "tags": [ "orchardcore" ],
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.HomeRoute",
        "OrchardCore.Admin",
        "OrchardCore.Diagnostics",
        "OrchardCore.DynamicCache",
        "OrchardCore.Features",
        "OrchardCore.Navigation",
        "OrchardCore.Recipes",
        "OrchardCore.Resources",
        "OrchardCore.Roles",
        "OrchardCore.Security",
        "OrchardCore.Settings",
        "OrchardCore.Themes",
        "OrchardCore.Users",
        "OrchardCore.Alias",
        "OrchardCore.Autoroute",
        "OrchardCore.Localization",
        "OrchardCore.ContentLocalization",
        "OrchardCore.ContentLocalization.ContentCulturePicker",
        "OrchardCore.Html",
        "OrchardCore.ContentFields",
        "OrchardCore.ContentPreview",
        "OrchardCore.Contents",
        "OrchardCore.ContentTypes",
        "OrchardCore.Flows",
        "OrchardCore.Liquid",
        "OrchardCore.Media",
        "OrchardCore.Menu",
        "OrchardCore.Seo",
        "OrchardCore.Templates",
        "OrchardCore.Title",
        "OrchardCore.Widgets",
        "OrchardCore.Layers",
        "OrchardCore.Workflows",
        "OrchardCore.Workflows.Timers",
        "OrchardCore.Workflows.Http",
        "OrchardCore.Shortcodes",
        "OrchardCore.Shortcodes.Templates",
        "OrchardCore.Tenants",
        "CrestApps.OrchardCore.AI.Mcp.Server",
        "CrestApps.OrchardCore.AI.ToolInstances",
        "TheAdmin",
        "TheOrchardCoreTheme.Module",
        "TheOrchardCoreTheme"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheOrchardCoreTheme"
    },
    {
      "name": "AIToolInstances",
      "instances": [
        {
          "ItemId": "[js: uuid()]",
          "Source": "search-index-documentation",
          "Name": "search_orchardcore_gallery",
          "Description": "Search the Gallery to discover community modules and themes that extend Orchard Core with reusable features, integrations, and site designs.",
          "OwnerId": "[js: parameters('AdminUserId')]",
          "Author": "[js: parameters('AdminUsername')]",
          "Properties": {
            "SearchIndexDocumentationToolSettings": {
              "BaseUrl": "https://gallery.orchardcore.net/",
              "IndexUrl": "https://gallery.orchardcore.net/search/search_index.json"
            }
          }
        },
        {
          "ItemId": "[js: uuid()]",
          "Source": "search-index-documentation",
          "Name": "search_orchardcore_docs",
          "Description": "Search the Official Orchard Core Documentations",
          "OwnerId": "[js: parameters('AdminUserId')]",
          "Author": "[js: parameters('AdminUsername')]",
          "Properties": {
            "SearchIndexDocumentationToolSettings": {
              "BaseUrl": "https://docs.orchardcore.net/",
              "IndexUrl": "https://docs.orchardcore.net/en/latest/search/search_index.json"
            }
          }
        },
        {
          "ItemId": "[js: uuid()]",
          "Source": "search-index-documentation",
          "Name": "search_crestapps_orchardcore_docs",
          "Description": "Browse the official CrestApps \u2013 Orchard Core Documentation to discover community-driven modules that extend Orchard Core with powerful capabilities, including AI-powered solutions and much more.",
          "OwnerId": "[js: parameters('AdminUserId')]",
          "Author": "[js: parameters('AdminUsername')]",
          "Properties": {
            "SearchIndexDocumentationToolSettings": {
              "BaseUrl": "https://orchardcore.crestapps.com/",
              "IndexUrl": "https://orchardcore.crestapps.com/search-index.json"
            }
          }
        }
      ]
    },
    {
      "name": "settings",
      "McpServerSettings": {
        "AuthenticationType": "None",
        "Tools": [
          "search_orchardcore_gallery",
          "search_orchardcore_docs",
          "search_crestapps_orchardcore_docs"
        ]
      }
    }
  ]
}
